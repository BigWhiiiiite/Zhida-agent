# Examples only. Generate a private local file with:
# python3.12 backend/scripts/backend_v2_stack.py init
# The generated backend/.env.v2.local is for this isolated development stack.
# These are NOT credentials for the existing backend or a deployment.
ZHIDA_V2_ENVIRONMENT=development
ZHIDA_V2_POSTGRES_PASSWORD=replace_with_random_hex
ZHIDA_V2_APP_DATABASE_PASSWORD=replace_with_another_random_hex
ZHIDA_V2_REDIS_PASSWORD=replace_with_random_hex
ZHIDA_V2_RABBITMQ_PASSWORD=replace_with_random_hex
ZHIDA_V2_POSTGRES_PORT=15432
ZHIDA_V2_REDIS_CACHE_PORT=16379
ZHIDA_V2_REDIS_CONTROL_PORT=16380
ZHIDA_V2_RABBITMQ_PORT=15674
ZHIDA_V2_RABBITMQ_MANAGEMENT_PORT=15672
ZHIDA_V2_API_PORT=18000
# Host-side process URLs. Compose uses internal service names instead.
ZHIDA_V2_DATABASE_URL=postgresql+psycopg://zhida_runtime:replace_with_another_random_hex@127.0.0.1:15432/zhida_v2
ZHIDA_V2_MIGRATION_DATABASE_URL=postgresql+psycopg://zhida_migrator:replace_with_random_hex@127.0.0.1:15432/zhida_v2
ZHIDA_V2_REDIS_CACHE_URL=redis://:replace_with_random_hex@127.0.0.1:16379/0
ZHIDA_V2_REDIS_CONTROL_URL=redis://:replace_with_random_hex@127.0.0.1:16380/0
ZHIDA_V2_BROKER_URL=amqp://zhida:replace_with_random_hex@127.0.0.1:15674/zhida
ZHIDA_V2_LOCAL_USER_ENABLED=false
ZHIDA_V2_LOCAL_USER_ID=local-development-user
# False is only for this loopback HTTP stack; use true behind HTTPS.
ZHIDA_V2_COOKIE_SECURE=false
# D1 control-plane only. Requires migration 0007 and same flag in API + workflow worker.
# Does NOT switch the existing workbench, run models or enable browser filling.
ZHIDA_V2_WORKFLOW_ENABLED=false
# D2 only analyzes explicit bound snapshots; no browser writes. Requires 0008.
ZHIDA_V2_RECOGNITION_ENABLED=false
# D3 local desktop Runner. Requires 0009 + both flags above; no final submit.
# Do not enable for container-only APIs that have no local browser connection.
ZHIDA_V2_ASSISTED_ENABLED=false
