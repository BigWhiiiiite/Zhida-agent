# agents_sdk: use the configured Responses API provider; rules: stay fully local
APP_AGENT_MODE=agents_sdk
APP_AGENT_MODEL=AWS-GPT-6-Astra
APP_AGENT_FALLBACK_MODEL=AWS-GPT-5.6-Sol
APP_AGENT_PROMPT_JSON_MODELS=AWS-GPT-6-Astra,AWS-GPT-5.6-Sol
APP_MODEL_BASE_URL=https://llmapi.isrc.ac.cn/v1
APP_MODEL_REASONING_EFFORT=low
APP_MODEL_MAX_RETRIES=0
APP_MODEL_TIMEOUT_SECONDS=180
APP_FORM_MODEL_TIMEOUT_SECONDS=180
APP_FORM_FALLBACK_TIMEOUT_SECONDS=120
APP_MODEL_API_KEY_ENV=ISRC_API_KEY
# Keep true in deployed environments. Set false only for a trusted local machine.
APP_AUTH_REQUIRED=true
APP_COOKIE_SECURE=false
APP_BROWSER_CHANNEL=chrome
# ISRC_API_KEY=
